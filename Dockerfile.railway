FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    DISPLAY=:99 \
    CHROME_BIN=/usr/bin/chromium \
    BRIDGE_DATA_DIR=/data \
    PORT=8080

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       chromium chromium-driver xvfb dbus ca-certificates fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY persistent-browser/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY persistent-browser/server.py /app/server.py
COPY persistent-browser/secure_server.py /app/secure_server.py

RUN mkdir -p /data
EXPOSE 8080
CMD ["sh", "-c", "dbus-uuidgen --ensure=/etc/machine-id && mkdir -p /run/dbus && dbus-daemon --system --fork && exec python /app/secure_server.py"]
